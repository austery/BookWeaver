{
  "default_model": "gemini-2.5-flash",
  "model_thresholds": {
    "small": {
      "max_chars": 5000,
      "model": "gemini-2.5-flash-lite"
    },
    "medium": {
      "max_chars": 10000,
      "model": "gemini-2.5-flash"
    },
    "large": {
      "max_chars": null,
      "model": "gemini-2.5-pro"
    }
  },
  "model_aliases": {
    "pro": "gemini-2.5-pro",
    "flash": "gemini-2.5-flash",
    "lite": "gemini-2.5-flash-lite"
  },
  "fallback_chain": [
    "flash",
    "lite"
  ],
  "output_format": "epub",
  "bilingual_style": "alternating",
  "enable_fallback": true,
  "prompt_profile": "default",
  "prompt_templates": {
    "default": "config/prompts/default_prompt.txt",
    "ebook": "config/prompts/ebook_prompt.txt"
  },
  "model_probe": {
    "enabled": true,
    "cache_ttl_seconds": 3600,
    "cache_path": "~/.cache/bookweaver/model_probe_cache.json",
    "candidates": [
      "gemini-2.5-pro",
      "gemini-2.5-flash",
      "gemini-2.5-flash-lite"
    ]
  },
  "gemini_api": {
    "enabled": true,
    "api_key": null,
    "model": "gemini-2.5-flash"
  },
  "epub_resilience": {
    "rate_limit_backoff_seconds": [60, 120],
    "timeout_backoff_seconds": [60],
    "transient_backoff_seconds": [45],
    "max_split_depth": null,
    "doc_failure_budget": null,
    "failed_docs_path": null,
    "cli_api_fallback_enabled": false,
    "pro_epub_max_batch_chars": 60000,
    "standard_epub_max_batch_chars": 60000,
    "pro_timeout_seconds": 300,
    "non_pro_timeout_seconds": 180
  },
  "terminology_extraction": {
    "enabled": false,
    "strategy": "minimal",
    "extraction_model": "gemini-2.5-pro",
    "max_terms": 20,
    "glossary_output_path": "{temp_dir}/extracted_glossary.json"
  },
  "sanity_probe": {
    "enabled": true,
    "max_length_ratio": 2.0,
    "min_length_ratio": 0.15,
    "min_source_length": 10,
    "min_cjk_density": 0.30,
    "heartbeat_chars": 60
  }
}
