{
  "gemini_api": {"api_key": null},
  "api": {"timeout_seconds": 600},
  "antigravity": {"timeout_seconds": 600},
  "codex": {"timeout_seconds": 600},
  "claude_code": {"timeout_seconds": 600},
  "epub_resilience": {
    "pro_epub_max_batch_chars": 60000,
    "standard_epub_max_batch_chars": 60000,
    "max_split_depth": 10,
    "max_batch_segments": 200
  },
  "terminology_extraction": {
    "enabled": false,
    "extraction_model": "pro",
    "max_terms": 20
  },
  "sanity_probe": {
    "enabled": true,
    "max_length_ratio": 2.0,
    "min_length_ratio": 0.15,
    "min_source_length": 20,
    "min_cjk_density": 0.3,
    "min_cjk_source_length": 40,
    "heartbeat_chars": 60
  },
  "terminology_panels": {
    "three-vendor": {
      "nominators": ["agy-flash-low", "codex-gpt-6.1-sol-low", "claude-opus-5-5-low"],
      "judges": ["codex-gpt-6.1-sol-low", "claude-opus-5-5-low"]
    }
  }
}
